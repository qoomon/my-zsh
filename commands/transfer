#!/usr/bin/env bash
set -euo pipefail

confirm_transfer() {
    local mode="${TRANSFER_SH_CONFIRM:-ask}"
    if [ "$mode" = "always" ]
    then
        return 0
    fi
    if [ "$mode" = "never" ]
    then
        echo "Refusing upload because TRANSFER_SH_CONFIRM=never" >&2
        return 1
    fi
    if ! tty -s
    then
        if [ "$mode" = "ask" ] && [ -r /dev/tty ]
        then
            echo "This will upload piped data to transfer.sh. Continue? [y/N] " > /dev/tty
            read -r answer < /dev/tty
            [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
            return $?
        fi
        echo "Refusing upload from non-interactive shell without TRANSFER_SH_CONFIRM=always" >&2
        return 1
    fi
    echo "This will upload data to transfer.sh. Continue? [y/N] " >&2
    read -r answer
    [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

function transfer { 
    # check arguments
    if [ $# -eq 0 ]
    then 
        echo "No arguments specified." >&2
        echo "Usage:" >&2
        echo "  transfer <file|directory>" >&2
        echo "  ... | transfer <file_name>" >&2
        return 1
    fi
    
    if tty -s
    then # transfer file or directory
        confirm_transfer || return 1
        file="$1"
        file_name=$(basename "$file")
        if [ ! -e "$file" ]
        then
            echo "$file: No such file or directory" >&2
            return 1
        fi
      
        if [ -d "$file" ]
        then  # transfer directory
            file_name="$file_name.zip" 
            (cd "$file" && zip -r -q - .) | curl --fail --progress-bar --upload-file "-" "https://transfer.sh/$file_name"
        else # transfer file
            curl --fail --progress-bar --upload-file "$file" "https://transfer.sh/$file_name"
        fi
    else # transfer pipe
        confirm_transfer || return 1
        file_name="$1"
        curl --fail --progress-bar --upload-file "-" "https://transfer.sh/$file_name"
    fi
}

transfer "$@"
