#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} [--insecure] [--http] [registry/]repo/image" >&2
}

docker-registry-image-tags() {
  if ! command -v jq >/dev/null 2>&1
  then
    echo "Missing dependency: jq" >&2
    return 1
  fi

  local insecure_flag=''
  local scheme='https'
  while [[ "${1:-}" == --* ]]
  do
    case "$1" in
      --insecure)
        insecure_flag='--insecure'
        shift
        ;;
      --http)
        scheme='http'
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage
        return 1
        ;;
    esac
  done

  local image_ref="${1:-}"
  if [ -z "$image_ref" ]
  then
    usage
    return 1
  fi

  local registry=''
  local image_name=''
  local first="${image_ref%%/*}"
  local rest="${image_ref#*/}"

  if [[ "$image_ref" == */* ]] && { [[ "$first" == *.* ]] || [[ "$first" == *:* ]] || [[ "$first" == 'localhost' ]]; }
  then
    registry="$first"
    image_ref="$rest"
  fi

  if [[ "$image_ref" == */* ]]
  then
    image_name="$image_ref"
  else
    image_name="library/$image_ref"
  fi

  local authorization_header=''
  if [[ -z "$registry" ]]
  then
    if [[ "$scheme" == 'http' ]]
    then
      echo "--http is only supported with explicitly specified registries" >&2
      return 1
    fi
    registry='registry-1.docker.io'
    local token=''
    token="$(curl -fsSL "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${image_name}:pull" | jq --raw-output '.token')"
    if [[ -z "$token" || "$token" == 'null' ]]
    then
      echo 'Unable to retrieve Docker Hub token' >&2
      return 1
    fi
    authorization_header="$(printf '%s %s %s' 'Authorization:' 'Bearer' "$token")"
  fi

  local response=''
  local curl_args=(-fsSL)
  if [[ -n "$insecure_flag" ]]
  then
    curl_args+=("$insecure_flag")
  fi
  if [[ -n "$authorization_header" ]]
  then
    response="$(curl "${curl_args[@]}" -H "$authorization_header" "${scheme}://${registry}/v2/${image_name}/tags/list")"
  else
    response="$(curl "${curl_args[@]}" "${scheme}://${registry}/v2/${image_name}/tags/list")"
  fi
  if echo "$response" | jq --exit-status 'has("errors")' >/dev/null
  then
    echo "$response" | jq -r '.errors[].message'
    return 1
  fi

  echo "$response" | jq -r '.tags[]?' | sort
}

docker-registry-image-tags "$@"
