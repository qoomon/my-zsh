#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} [--insecure] [registry/]repo/image" >&2
}

docker-registry-image-tags() {
  local insecure_flag=''
  if [ "${1:-}" = '--insecure' ]
  then
    insecure_flag='--insecure'
    shift
  fi

  local image_ref="${1:-}"
  if [ -z "$image_ref" ]
  then
    usage
    return 1
  fi

  local registry=''
  local repository=''
  local image=''
  local first="${image_ref%%/*}"
  local rest="${image_ref#*/}"

  if [[ "$image_ref" == */* ]] && { [[ "$first" == *.* ]] || [[ "$first" == *:* ]] || [[ "$first" == 'localhost' ]]; }
  then
    registry="$first"
    image_ref="$rest"
  fi

  if [[ "$image_ref" == */* ]]
  then
    repository="${image_ref%/*}"
    image="${image_ref##*/}"
  else
    repository='library'
    image="$image_ref"
  fi

  local authorization_header=''
  if [[ -z "$registry" ]]
  then
    registry='registry-1.docker.io'
    local token=''
    token="$(curl -fsSL "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repository}/${image}:pull" | jq --raw-output '.token')"
    if [[ -z "$token" || "$token" == 'null' ]]
    then
      echo 'Unable to retrieve Docker Hub token' >&2
      return 1
    fi
    authorization_header="$(printf '%s %s %s' 'Authorization:' 'Bearer' "$token")"
  fi

  local response=''
  if [[ -n "$authorization_header" ]]
  then
    response="$(curl -fsSL ${insecure_flag:+$insecure_flag} -H "$authorization_header" "https://${registry}/v2/${repository}/${image}/tags/list")"
  else
    response="$(curl -fsSL ${insecure_flag:+$insecure_flag} "https://${registry}/v2/${repository}/${image}/tags/list")"
  fi
  if echo "$response" | jq --exit-status 'has("errors")' >/dev/null
  then
    echo "$response" | jq -r '.errors[].message'
    return 1
  fi

  echo "$response" | jq -r '.tags[]?' | sort
}

docker-registry-image-tags "$@"
