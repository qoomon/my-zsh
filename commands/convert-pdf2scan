#!/usr/bin/env bash
set -euo pipefail
################################################
#
# Prerequisites:
#   ensure ImageMagick is installed
#
# Usage:
#   convert-pdf2scan [--gray] files...
#
################################################
usage() {
  echo "Usage: ${0##*/} [--gray] <file.pdf>..." >&2
}

colorspace=""
if [ "${1:-}" == "--gray" ]
then
  colorspace="Gray"
  shift
fi

tilt_min=0.02
tilt_max=0.06
density=100
noise=0.15

cleanup_dirs=()
cleanup() {
  local dir
  for dir in "${cleanup_dirs[@]}"
  do
    if [ -d "$dir" ]
    then
      rm -rf "$dir"
    fi
  done
  return 0
}
trap cleanup EXIT

if [ "$#" -eq 0 ]
then
  usage
  exit 1
fi

for input in "$@"
do
  if [ ! -f "$input" ]
  then
    echo "Input file not found: $input" >&2
    exit 1
  fi

  build_dir="$(mktemp -d "${TMPDIR:-/tmp}"/pdf2scan.XXXX)"
  cleanup_dirs+=("$build_dir")
  output_file="$(basename "$input" .pdf)_scan.pdf"
  
  # process each page
  page_count=$(identify -ping "$input" | wc -l | bc)
  for (( page_index=0; page_index<page_count; page_index++ ))
  do
    echo "process page $(bc <<< "$page_index + 1")/$page_count ..."
    
    # randomize tilt
    tilt=$(bc -l <<< "$tilt_min + ($tilt_max - $tilt_min) * ($RANDOM/32767)")
    if (( RANDOM % 2 == 0 ))
    then
      tilt=-$tilt
    fi
    
    convert \
      -density $density \
      "${input}[${page_index}]" \
      -background none \
      -rotate "$tilt" \
      -attenuate $noise \
      +noise Multiplicative \
      ${colorspace:+-colorspace $colorspace} \
      -sharpen 0x1.0 \
      "$build_dir/page_${page_index}.pdf"
  done
  
  # merge pages
  echo "merge pages into '$output_file' ..."
  scan_pages=()
  while IFS= read -r page
  do
    scan_pages+=("$page")
  done < <(find "$build_dir" -maxdepth 1 -name 'page_*.pdf' -type f | sort -V)
  convert \
    -density $density \
    -compress jpeg -quality 80 \
    "${scan_pages[@]}" \
    "$output_file"
  
  echo "done!"
  rm -rf "$build_dir"
done
